# Local frontend against the wwwdev OLS backend.
# Usage: REACT_APP_ENV=wwwdev PORT=3001 npm start
# The browser calls the local dev server, which proxies /api/* to wwwdev (avoids CORS).
PUBLIC_URL=/
REACT_APP_APIURL=http://localhost:3001/
OLS_DEV_BACKEND_PROXY_URL=https://wwwdev.ebi.ac.uk/spot/ontoapps/ols/
