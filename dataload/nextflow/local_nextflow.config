process.container = System.getenv('OLS4_DATALOAD_IMAGE')
docker.enabled = true
// Ensure tasks run with the host UID:GID to avoid permission issues in mounted work dirs
docker.runOptions = "-u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('OLS_HOME')}:${System.getenv('OLS_HOME')} -v ${System.getenv('OLS_EMBEDDINGS_PATH')}:${System.getenv('OLS_EMBEDDINGS_PATH')}"

params.solr_mem = "4g"
params.neo_mem = "4g"

process {
    withName: rdf2json {
        memory = 5.GB
    }
}

process {
    withName: linker__create_manifest {
        memory = 5.GB
    }
}

process {
    withName: linker__link_ontologies {
        memory = 5.GB
    }
}

process {
    withName: json2neo {
        memory = 5.GB
    }
}

process {
    withName: json2solr {
        memory = 5.GB
    }
}

process {
    withName: create_neo {
        memory = 5.GB
    }
}

process {
    withName: create_solr {
        memory = 5.GB
    }
}
