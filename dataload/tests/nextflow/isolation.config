docker.enabled = true
process.container = params.test_image
// The fixtures live outside the task directory and use absolute local RDF paths.
docker.runOptions = "--shm-size=512m -u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('OLS_HOME')}:${System.getenv('OLS_HOME')}"
process {
    withName: rdf2json {
        memory = 512.MB
        cpus = 1
        publishDir = [path: "${params.results}/json", mode: 'copy']
        // Exercise a genuine task exit, in addition to RDF2JSON's semantic failure.
        beforeScript = { ontology_id == 'crash' ? 'exit 42' : '' }
    }
    withName: create_postgres {
        memory = 512.MB
        cpus = 1
        publishDir = [path: "${params.results}/cluster", enabled: false]
    }
    withName: json2postgres {
        memory = 512.MB
        cpus = 1
        publishDir = [path: "${params.results}/binary", mode: 'copy']
    }
}
params.dataload_args = '--loadLocalFiles --noDates'
params.last_run_dir = ''

trace.fields = 'task_id,name,status,exit,workdir'
